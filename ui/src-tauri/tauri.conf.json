{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Syscura",
  "mainBinaryName": "Syscura",
  "version": "1.1.0",
  "identifier": "com.syscura.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Syscura",
        "width": 1400,
        "height": 880,
        "minWidth": 1000,
        "minHeight": 660,
        "backgroundColor": "#f4f4f8"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/syscura-agent",
      "binaries/syscura-cli"
    ],
    "publisher": "Ibrar Ahmad",
    "copyright": "Copyright (c) 2026 Ibrar Ahmad. MIT License.",
    "homepage": "https://github.com/hiibrarahmad/syscura",
    "shortDescription": "Syscura: PC health and safety guard",
    "longDescription": "Watches Windows for software, hardware and security problems, explains them in plain language, and fixes what it safely can.",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "startMenuFolder": "Syscura"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
